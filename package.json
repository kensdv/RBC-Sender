{
  "name": "rbc-sender",
  "version": "1.0.0",
  "description": "Consent-based web mailer with direct authenticated SMTP",
  "main": "server/index.js",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch server/index.js",
    "dev:client": "vite",
    "setup": "node scripts/setup.mjs",
    "build": "vite build",
    "start": "node server/index.js",
    "test": "node --test",
    "build:watch": "vite build --watch"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "license": "UNLICENSED",
  "type": "module",
  "dependencies": {
    "@faker-js/faker": "^9.2.0",
    "@fastify/static": "10.1.11",
    "fastify": "5.12.8",
    "jimp": "^0.22.12",
    "nodemailer": "10.6.0",
    "pdf-lib": "^1.17.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "socks": "^2.8.3"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.3.0",
    "concurrently": "10.0.7",
    "vite": "8.3.8"
  }
}
